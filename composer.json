{
    "name": "componenta/identity",
    "description": "Identity contracts and immutable identities for Componenta",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "componenta/config": "^3.0 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Identity\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "componenta": {
            "config-providers": [
                "Componenta\\Identity\\ConfigProvider"
            ]
        },
        "branch-alias": {
            "dev-fix/callback-dependency-baseline-2026-11-26": "1.1.x-dev"
        }
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Identity\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php vendor/bin/pest --exclude-group=stress",
            "@php vendor/bin/pest --configuration=phpunit.controlled.xml"
        ],
        "stress": "@php -d memory_limit=256M vendor/bin/pest --group=stress",
        "phpstan": "@php vendor/bin/phpstan analyse src --level=max",
        "check": [
            "@phpstan",
            "@test"
        ],
        "test:negative": "@php tests/Quality/negative-controls.php",
        "test:mutation": [
            "Composer\\Config::disableProcessTimeout",
            "@php -d opcache.enable_cli=0 tests/Quality/mutate.php --configuration=phpunit.mutation.xml --mutate --everything --no-cache"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
