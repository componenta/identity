{
    "name": "componenta/identity",
    "description": "Identity contracts and immutable identities for Componenta",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "componenta/config": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Identity\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "componenta": {
            "config-providers": [
                "Componenta\\Identity\\ConfigProvider"
            ]
        }
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Identity\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php vendor/bin/pest",
            "@php vendor/bin/pest --configuration=phpunit.controlled.xml",
            "@php tests/generator-contract.php"
        ],
        "stress": "@php -d memory_limit=256M tests/stress.php",
        "phpstan": "@php vendor/bin/phpstan analyse src --level=max",
        "check": [
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
